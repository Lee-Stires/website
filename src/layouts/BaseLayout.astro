---
import SEO, { type Props as SEOProps } from '@/components/SEO.astro';
import '@/styles/global.css';

interface Props extends SEOProps {
  bodyClass?: string;
}

const { bodyClass, ...restProps }: Props = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SEO {...restProps} />
    <slot name="head" />

    <script>
      import { isEmbeddedInLab } from '@/lib/lab-bridge';

      const websiteId = import.meta.env.PUBLIC_ANALYTICS_WEBSITE_ID;
      if (websiteId && !isEmbeddedInLab()) {
        const script = document.createElement('script');
        script.defer = true;
        script.src = 'https://analytics.phxlab.io/script.js';
        script.dataset.websiteId = websiteId;
        document.head.appendChild(script);
      }
    </script>
  </head>
  <body class:list={['flex min-h-screen flex-col', bodyClass]}>
    <slot />

    <style is:global>
      [data-lab-selected] {
        outline: 2px solid #2563eb;
        outline-offset: -2px;
      }
    </style>
    <script>
      import { initLabBridge } from '@/lib/lab-bridge';

      initLabBridge();
    </script>
  </body>
</html>
