---
import Container from '@/components/Container.astro';
import RenditionPicture from '@/components/RenditionPicture.astro';
import { HERO_IMAGE } from './media';

interface Props {
  image: string;
  imageAlt: string;
}

const { image, imageAlt }: Props = Astro.props;
---

<Container class="mt-10">
  <RenditionPicture
    src={image}
    height={750}
    width={1570}
    widths={HERO_IMAGE.widths}
    sizes={HERO_IMAGE.sizes}
    alt={imageAlt}
    class="h-auto w-full"
    loading="eager"
    fetchpriority="high"
  />
</Container>
