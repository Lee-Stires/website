---
import Container from '@/components/Container.astro';
import R2Picture from '@/components/R2Picture.astro';

interface Props {
  image: string;
  imageAlt: string;
}

const { image, imageAlt }: Props = Astro.props;
---

<Container class="mt-10">
  <R2Picture
    src={image}
    height={750}
    width={1570}
    alt={imageAlt}
    class="h-auto w-full"
    loading="eager"
  />
</Container>
