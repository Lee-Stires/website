---
import Container from '@/components/Container.astro';
import { Marked } from 'marked';

interface Props {
  body: string;
}

const { body }: Props = Astro.props;

const marked = new Marked({ gfm: true, breaks: false });

marked.use({
  renderer: {
    // Content is Markdown authored in the Lab editor — drop any raw HTML.
    html: () => '',
    paragraph({ tokens }) {
      return `<p class="mb-4 last:mb-0">${this.parser.parseInline(tokens)}</p>`;
    },
    link({ href, title, tokens }) {
      const text = this.parser.parseInline(tokens);
      const titleAttr = title ? ` title="${title}"` : '';
      return `<a class="focus-visible:outline-primary underline focus-visible:outline-2 focus-visible:outline-offset-2" target="_blank" rel="noreferrer" href="${href}"${titleAttr}>${text}</a>`;
    },
  },
});

const html = marked.parse(body ?? '', { async: false }) as string;
---

<Container class="mt-10">
  <Fragment set:html={html} />
</Container>
