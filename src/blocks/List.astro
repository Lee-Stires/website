---
import Container from '@/components/Container.astro';

interface Props {
  title: string;
  description: string;
  items: string[];
}

const { title, description, items }: Props = Astro.props;
---

<div class="border-t-5 border-t-neutral-500 pt-10">
  <Container>
    <div class="text-center">
      <h3 class="mb-4 text-2xl font-bold">{title}</h3>
      <p>{description}</p>
    </div>

    <div class="flex justify-center">
      <ul class="mt-4 w-full max-w-3xl gap-x-12 font-bold md:columns-2">
        {
          items.map((item) => (
            <li class="relative mb-3 break-inside-avoid pl-5 text-left before:absolute before:top-0 before:left-0 before:text-gray-400 before:content-['-']">
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</div>
