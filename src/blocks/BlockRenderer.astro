---
import type { Block } from './schema';
import { registry } from './registry';

interface Props {
  blocks: Block[];
}

const { blocks }: Props = Astro.props;
---

{
  blocks.map((block) => {
    const Component = registry[block._type];
    return (
      <div data-lab-id={block._labId ?? undefined} data-lab-type={block._type}>
        <Component {...block} />
      </div>
    );
  })
}
