---
import Container from '@/components/Container.astro';
import RenditionPicture from '@/components/RenditionPicture.astro';
import { IMAGE_GROUP_IMAGE } from './media';

interface Props {
  images: {
    image: string;
    alt: string;
  }[];
}

const { images }: Props = Astro.props;
---

<Container>
  <div class="my-8 flex flex-col items-center lg:flex-row">
    {
      images.map((item) => (
        <RenditionPicture
          src={item.image}
          alt={item.alt}
          height={243}
          width={523}
          widths={IMAGE_GROUP_IMAGE.widths}
          sizes={IMAGE_GROUP_IMAGE.sizes}
          class="w-full"
        />
      ))
    }
  </div>
</Container>
