---
import { getEntry } from 'astro:content';
import BlockRenderer from '@/blocks/BlockRenderer.astro';
import { Layout } from '@/layouts';

const page = await getEntry('pages', 'index');
if (!page) throw new Error('Missing content: src/content/pages/index.json');
---

<Layout
  title={page.data.title}
  description={page.data.description}
  canonical={page.data.canonical}
  noindex={page.data.noindex}
  ogTitle={page.data.ogTitle}
  ogDescription={page.data.ogDescription}
  ogType={page.data.ogType}
  ogImage={page.data.ogImage}
  ogImageAlt={page.data.ogImageAlt}
>
  <BlockRenderer blocks={page.data.blocks} />
</Layout>
