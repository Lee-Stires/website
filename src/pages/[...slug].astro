---
import { getEntry } from 'astro:content';
import BlockRenderer from '@/blocks/BlockRenderer.astro';
import { NotFound } from '@/components';
import { Layout } from '@/layouts';

const { slug } = Astro.params;
const page = slug ? await getEntry('pages', slug) : undefined;

if (!page) {
  Astro.response.status = 404;
}
---

<Layout
  title={page ? page.data.title : 'Page Not Found'}
  description={page?.data.description}
  canonical={page?.data.canonical}
  noindex={page?.data.noindex}
  ogTitle={page?.data.ogTitle}
  ogDescription={page?.data.ogDescription}
  ogType={page?.data.ogType}
  ogImage={page?.data.ogImage}
  ogImageAlt={page?.data.ogImageAlt}
>
  {page ? <BlockRenderer blocks={page.data.blocks} /> : <NotFound />}
</Layout>
