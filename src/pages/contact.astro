---
import { getEntry } from 'astro:content';
import BlockRenderer from '@/blocks/BlockRenderer.astro';
import { Layout } from '@/layouts';

const page = await getEntry('pages', 'contact');
if (!page) throw new Error('Missing content: src/content/pages/contact.json');
---

<Layout title={page.data.title} description={page.data.description}>
  <BlockRenderer blocks={page.data.blocks} />
</Layout>
