---
import Container from '@/components/Container.astro';

const navList = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about/' },
  { label: 'Services', href: '/services/' },
  { label: 'Gallery', href: '/gallery/' },
  { label: 'Contact', href: '/contact/' },
  { label: 'Careers', href: '/careers/' },
];

const path = Astro.url.pathname;
---

<header class="relative z-50 pt-10">
  <Container>
    <a href="/" class="group block">
      <p
        class="text-primary font-brand text-center text-4xl uppercase transition-transform duration-300 text-shadow-[5px_10px_10px_#000] group-hover:scale-[1.01] motion-reduce:transition-none sm:text-5xl md:text-6xl lg:text-7xl xl:text-8xl 2xl:text-9xl"
      >
        Lee &amp; stires, Inc.
      </p>
    </a>

    <nav aria-label="Main">
      <!-- Mobile -->
      <div class="relative mt-8 lg:hidden">
        <button
          id="mobile-menu-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Open main menu"
          class="bg-secondary hover:bg-secondary/90 focus-visible:outline-primary flex w-full items-center justify-center gap-2 px-6 py-3 font-bold tracking-wider text-neutral-900 uppercase transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 motion-reduce:transition-none"
        >
          <svg
            data-icon="open"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="4" x2="20" y1="12" y2="12"></line>
            <line x1="4" x2="20" y1="6" y2="6"></line>
            <line x1="4" x2="20" y1="18" y2="18"></line>
          </svg>
          <svg
            data-icon="close"
            hidden
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M18 6 6 18"></path>
            <path d="m6 6 12 12"></path>
          </svg>
          <span data-label>Menu</span>
        </button>

        <div
          id="mobile-menu"
          inert
          class="border-secondary pointer-events-none absolute inset-x-0 top-full z-50 flex -translate-y-2 flex-col border-t-2 bg-neutral-900/95 text-center opacity-0 shadow-xl backdrop-blur-sm transition-[opacity,transform] duration-300 motion-reduce:transition-none"
        >
          {
            navList.map((item) => (
              <a
                href={item.href}
                class:list={[
                  'hover:text-secondary focus-visible:outline-primary border-b border-white/10 py-5 text-lg font-medium text-white transition-colors hover:bg-white/5 focus-visible:outline-2 focus-visible:-outline-offset-2 motion-reduce:transition-none',
                  path === item.href && 'text-secondary font-bold',
                ]}
              >
                {item.label}
              </a>
            ))
          }
        </div>
      </div>

      <!-- Desktop -->
      <ul
        class="mt-20 mb-10 hidden flex-wrap justify-center gap-x-14 gap-y-4 lg:flex"
      >
        {
          navList.map((item) => {
            const isActive = path === item.href;
            return (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    'focus-visible:outline-primary border-b-4 text-3xl transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 motion-reduce:transition-none',
                    isActive
                      ? 'text-primary border-secondary font-bold'
                      : 'hover:text-primary hover:border-secondary/30 border-transparent text-neutral-500',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </Container>
</header>

<script>
  const toggle = document.getElementById(
    'mobile-menu-toggle',
  ) as HTMLButtonElement | null;
  const panel = document.getElementById('mobile-menu');
  const openIcon =
    toggle?.querySelector<SVGElement>('[data-icon="open"]') ?? null;
  const closeIcon =
    toggle?.querySelector<SVGElement>('[data-icon="close"]') ?? null;
  const labelEl = toggle?.querySelector<HTMLElement>('[data-label]') ?? null;

  if (toggle && panel && openIcon && closeIcon && labelEl) {
    const links = Array.from(panel.querySelectorAll<HTMLAnchorElement>('a'));
    let open = false;

    function setOpen(next: boolean): void {
      open = next;
      toggle!.setAttribute('aria-expanded', String(next));
      toggle!.setAttribute(
        'aria-label',
        next ? 'Close main menu' : 'Open main menu',
      );
      labelEl!.textContent = next ? 'Close' : 'Menu';
      openIcon!.hidden = next;
      closeIcon!.hidden = !next;

      if (next) {
        panel!.removeAttribute('inert');
        panel!.classList.remove(
          'pointer-events-none',
          'opacity-0',
          '-translate-y-2',
        );
        links[0]?.focus();
      } else {
        panel!.setAttribute('inert', '');
        panel!.classList.add(
          'pointer-events-none',
          'opacity-0',
          '-translate-y-2',
        );
      }
    }

    function closeMenu(): void {
      if (!open) return;
      setOpen(false);
      toggle!.focus();
    }

    toggle.addEventListener('click', (): void => {
      setOpen(!open);
    });

    document.addEventListener('keydown', (event: KeyboardEvent): void => {
      if (!open) return;
      if (event.key === 'Escape') {
        closeMenu();
        return;
      }
      if (event.key === 'Tab') {
        const focusables = [toggle!, ...links];
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        const active = document.activeElement as HTMLElement;
        if (event.shiftKey && active === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && active === last) {
          event.preventDefault();
          first.focus();
        }
      }
    });

    document.addEventListener('click', (event: MouseEvent): void => {
      if (!open) return;
      const target = event.target as Node;
      if (!panel!.contains(target) && !toggle!.contains(target)) {
        closeMenu();
      }
    });

    links.forEach((link): void => {
      link.addEventListener('click', (): void => {
        setOpen(false);
      });
    });
  }
</script>
