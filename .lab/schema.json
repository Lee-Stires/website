{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "_type": {
          "type": "string",
          "const": "hero"
        },
        "_labId": {
          "type": "string",
          "hidden": true,
          "format": "uuid"
        },
        "image": {
          "type": "string",
          "format": "image",
          "aspectRatio": "157/75",
          "sizes": "(min-width: 1536px) 1472px, (min-width: 1024px) 960px, calc(100vw - 2rem)",
          "widths": [592, 960, 1184, 1472, 1920, 2944]
        },
        "imageAlt": {
          "type": "string"
        }
      },
      "required": ["_type", "_labId", "image", "imageAlt"],
      "additionalProperties": false,
      "title": "Hero"
    },
    {
      "type": "object",
      "properties": {
        "_type": {
          "type": "string",
          "const": "text"
        },
        "_labId": {
          "type": "string",
          "hidden": true,
          "format": "uuid"
        },
        "body": {
          "type": "string",
          "format": "markdown"
        }
      },
      "required": ["_type", "_labId", "body"],
      "additionalProperties": false,
      "title": "Text"
    },
    {
      "type": "object",
      "properties": {
        "_type": {
          "type": "string",
          "const": "imageGroup"
        },
        "_labId": {
          "type": "string",
          "hidden": true,
          "format": "uuid"
        },
        "images": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "image": {
                "type": "string",
                "format": "image",
                "aspectRatio": "523/243",
                "sizes": "(min-width: 1024px) 320px, (min-width: 640px) 490px, min(calc(100vw - 2rem), 490px)",
                "widths": [320, 490, 640, 980]
              },
              "alt": {
                "type": "string"
              }
            },
            "required": ["image", "alt"],
            "additionalProperties": false
          }
        }
      },
      "required": ["_type", "_labId", "images"],
      "additionalProperties": false,
      "title": "Image Group"
    },
    {
      "type": "object",
      "properties": {
        "_type": {
          "type": "string",
          "const": "services"
        },
        "_labId": {
          "type": "string",
          "hidden": true,
          "format": "uuid"
        },
        "services": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "image": {
                "type": "string",
                "format": "image",
                "aspectRatio": "24/13",
                "sizes": "(min-width: 360px) 360px, 100vw",
                "widths": [360, 720, 1080]
              },
              "imageAlt": {
                "type": "string"
              }
            },
            "required": ["name", "description", "image", "imageAlt"],
            "additionalProperties": false
          }
        }
      },
      "required": ["_type", "_labId", "services"],
      "additionalProperties": false,
      "title": "Services"
    },
    {
      "type": "object",
      "properties": {
        "_type": {
          "type": "string",
          "const": "list"
        },
        "_labId": {
          "type": "string",
          "hidden": true,
          "format": "uuid"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["_type", "_labId", "title", "description", "items"],
      "additionalProperties": false,
      "title": "List"
    },
    {
      "type": "object",
      "properties": {
        "_type": {
          "type": "string",
          "const": "gallery"
        },
        "_labId": {
          "type": "string",
          "hidden": true,
          "format": "uuid"
        },
        "series": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "photos": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "image": {
                      "type": "string",
                      "format": "image",
                      "aspectRatio": "1/1",
                      "sizes": "(min-width: 1024px) 470px, (min-width: 640px) 300px, 100vw",
                      "widths": [300, 470, 600, 940, 1600]
                    },
                    "alt": {
                      "type": "string"
                    }
                  },
                  "required": ["image", "alt"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["id", "name", "photos"],
            "additionalProperties": false
          }
        }
      },
      "required": ["_type", "_labId", "series"],
      "additionalProperties": false,
      "title": "Gallery"
    },
    {
      "type": "object",
      "properties": {
        "_type": {
          "type": "string",
          "const": "contact"
        },
        "_labId": {
          "type": "string",
          "hidden": true,
          "format": "uuid"
        },
        "heading": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "fax": {
          "type": "string"
        },
        "emails": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string"
              }
            },
            "required": ["name", "email"],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "_type",
        "_labId",
        "heading",
        "address",
        "phone",
        "fax",
        "emails"
      ],
      "additionalProperties": false,
      "title": "Contact"
    },
    {
      "type": "object",
      "properties": {
        "_type": {
          "type": "string",
          "const": "careers"
        },
        "_labId": {
          "type": "string",
          "hidden": true,
          "format": "uuid"
        },
        "heading": {
          "type": "string"
        },
        "positions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "applicationFile": {
          "type": "string",
          "format": "file",
          "accept": "application/pdf"
        }
      },
      "required": [
        "_type",
        "_labId",
        "heading",
        "positions",
        "applicationFile"
      ],
      "additionalProperties": false,
      "title": "Careers"
    }
  ]
}
